                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    s.CustomerID,
    s.CustomerName,
    s.Email,
    s.City,
    s.State,
    s.SourceFileName,
    ROW_NUMBER() OVER (PARTITION BY s.CustomerID ORDER BY s.LoadedDate) AS RowNum,
    CASE WHEN dc.CustomerID IS NOT NULL THEN 1 ELSE 0 END AS AlreadyLoaded
FROM dbo.stg_Customers s
LEFT JOIN dbo.DimCustomer dc ON dc.CustomerID = s.CustomerID</property>
