                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    s.SaleID,
    s.SaleDate,
    TRY_CONVERT(DATE, s.SaleDate, 120) AS SaleDateConverted,
    s.CustomerID,
    s.ProductID,
    s.StoreID,
    s.Quantity,
    s.UnitPrice,
    s.SourceFileName,
    ROW_NUMBER() OVER (PARTITION BY s.SaleID ORDER BY s.LoadedDate) AS RowNum,
    CASE WHEN fs.SaleID IS NOT NULL THEN 1 ELSE 0 END AS AlreadyLoaded
FROM dbo.stg_Sales s
LEFT JOIN dbo.FactSales fs ON fs.SaleID = TRY_CAST(s.SaleID AS INT)
WHERE s.SourceFileName = ?</property>
                    <property
